+  /**
+   * Keep playing when the user swipes the app away from Recents.
+   *
+   * Media3's default implementation decides via isPlaybackOngoing(), which only
+   * tracks foreground state started by its own MediaNotificationManager. This
+   * service posts its foreground notification itself (onUpdateNotification), so
+   * that check is always false and the default would pause and stop playback.
+   * Only fall back to the default (pause + stop) when nothing is playing.
+   */
+  override fun onTaskRemoved(rootIntent: Intent?) {
+    val player = currentPlayer?.ref
+    val isPlaying = player != null && (player.isPlaying || player.playWhenReady)
+    if (!isPlaying) {
+      super.onTaskRemoved(rootIntent)
+    }
+  }
